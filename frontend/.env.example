# Optional — leave empty in development (Vite proxies /api to the backend).
VITE_API_BASE_URL=
VITE_BRAND_NAME=MediCore HMS
# Map tiles for the hospital location maps. Default: OpenStreetMap's public servers (fine for light use).
# For heavy production use, put a tile provider URL here, e.g. https://tile.example.com/{z}/{x}/{y}.png?key=...
VITE_MAP_TILE_URL=
