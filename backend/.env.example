# ─── Copy to backend/.env and fill in. NEVER commit .env ───────────────────────
NODE_ENV=development
PORT=5000

# SQL Server — either one ADO.NET connection string …
DB_CONNECTION_STRING="Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;"
# … or individual values (used only when DB_CONNECTION_STRING is empty)
# DB_SERVER=localhost
# DB_PORT=1433
# DB_NAME=medicore_hms
# DB_USER=hms_app
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=true   # only for local dev with self-signed certs
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=30000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false          # true in staging/production (HTTPS)
# COOKIE_DOMAIN=.app.example.com   # set in production so cookies work on tenant subdomains

# URLs / tenancy
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_BASE_DOMAIN=localhost    # production: app.example.com  → tenants at <slug>.app.example.com
TRUST_PROXY=0                # 1 when behind a reverse proxy / load balancer

# Payments: sandbox (local only) | razorpay
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_SECRET=change-me-local-only
RAZORPAY_KEY_ID=             # rzp_test_… from Razorpay Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # set when creating the webhook (Dashboard → Webhooks)
SUBSCRIPTION_GRACE_DAYS=7

# First platform Super Admin (created by `npm run db:seed`)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Admin

# ─── Outgoing messages ─────────────────────────────────────────────────────────
# "log" = nothing is delivered; messages are written to the server log + Message log (development).
EMAIL_PROVIDER=log            # log | smtp
EMAIL_FROM="MediCore HMS <no-reply@yourdomain.com>"
SMTP_HOST=                    # e.g. smtp.gmail.com / smtp.zoho.in / your provider
SMTP_PORT=587
SMTP_SECURE=false             # true for port 465
SMTP_USER=
SMTP_PASS=
WHATSAPP_PROVIDER=log         # log | meta  (WhatsApp Cloud API)
WHATSAPP_TOKEN=               # permanent access token from Meta Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
DEFAULT_COUNTRY_CODE=91
# Background jobs: appointment reminders, subscription reminders, daily summaries
JOBS_ENABLED=true
JOBS_INTERVAL_SEC=300
# Require an e-mailed code for Super Admin sign-in (needs EMAIL_PROVIDER=smtp in production)
SUPERADMIN_MFA=false
# Only if hospitals (Enterprise plan) connect their OWN e-mail/WhatsApp: key used to encrypt their passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   — keep it safe; never change it casually.
MESSAGING_ENCRYPTION_KEY=
